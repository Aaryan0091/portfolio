# Copy this file to .env.local and fill in the values.

# "Got an Idea?" form → your inbox (src/app/api/contact/route.ts)
# Get a free API key at https://resend.com/api-keys
RESEND_API_KEY=
# Where messages are delivered (defaults to aaryangupta2005@gmail.com).
CONTACT_TO_EMAIL=aaryangupta2005@gmail.com
# Leave as-is until you verify your own domain in Resend.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: hero background video hosted elsewhere (hero-video.tsx).
NEXT_PUBLIC_HERO_VIDEO_URL=

# Ask AI (/ask-ai) — set ONE key (src/app/api/ask/route.ts). Without any,
# Ask AI falls back to built-in canned answers.
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: a different Groq model (default openai/gpt-oss-120b).
GROQ_MODEL=
# Optional: any other OpenAI-compatible provider's API base URL — put its
# key in GROQ_API_KEY and one of its model names in GROQ_MODEL.
AI_BASE_URL=
# Or Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
